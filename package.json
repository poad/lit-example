{
  "name": "lit-example",
  "private": true,
  "version": "0.1.0",
  "description": "A simple web component",
  "main": "dist/my-element.js",
  "module": "dist/my-element.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist/my-element.{d.ts,d.ts.map,js,js.map} test/my-element.{d.ts,d.ts.map,js,js.map} test/my-element_test.{d.ts,d.ts.map,js,js.map}",
    "lint": "pnpm lint:lit-analyzer && pnpm lint:eslint",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "lint:lit-analyzer": "lit-analyzer",
    "lint-fix": "pnpm lint --fix",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "analyze:watch": "cem analyze --litelement --globs \"src/**/*.ts\" --watch",
    "serve": "wds --watch",
    "serve:prod": "MODE=prod pnpm serve",
    "test": "pnpm test:dev && pnpm test:prod",
    "test:dev": "wtr",
    "test:watch": "wtr --watch",
    "test:prod": "MODE=prod wtr",
    "test:prod:watch": "MODE=prod wtr --watch",
    "checksize": "rolldown -c ; cat dist/my-element.bundled.js | gzip -9 | wc -c ; rm dist/my-element.bundled.js"
  },
  "keywords": [
    "web-components",
    "lit-element",
    "typescript",
    "lit"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server": "^1.0.0",
    "@web/dev-server-legacy": "^3.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "jiti": "^2.7.0",
    "lit-analyzer": "^2.0.3",
    "mocha": "^11.8.0",
    "prismjs": "^1.30.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "customElements": "custom-elements.json",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    }
  }
}
